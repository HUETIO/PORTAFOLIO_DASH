# Development reCAPTCHA Enterprise checkbox key authorized for localhost.
VITE_RECAPTCHA_ENTERPRISE_CHECKBOX_SITE_KEY=your_recaptcha_enterprise_checkbox_site_key

# Add the production checkbox key for portafoliodash.web.app to .env.production.local.
# Configure that same key as RECAPTCHA_ENTERPRISE_CHECKBOX_SITE_KEY in functions/.env.portafoliodash.

# Optional URL override for testing against the Firebase Functions emulator.
# VITE_SALES_REQUEST_URL=http://127.0.0.1:5001/portafoliodash/us-central1/submitSalesRequest

# Browser-visible Gemini API key for the technology assistant and opportunity diagnosis.
# Restrict it to the Generative Language API and your authorized website referrers.
VITE_GEMINI_API_KEY=your_restricted_gemini_api_key
